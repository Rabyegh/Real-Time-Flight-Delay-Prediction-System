  "panels": [
    {
      "id": 1,
      "title": "Prediction Throughput",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(flight_delay_predictions_total[1m]))",
          "legendFormat": "Predictions ({{status}}) / sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Inference Latency Percentiles",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(flight_delay_prediction_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 Latency (s)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(flight_delay_prediction_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency (s)",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(flight_delay_prediction_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 Latency (s)",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "title": "Predicted Delayed vs Not-Delayed Ratio",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(flight_delay_predictions_total{status='delayed'}[5m])) / sum(rate(flight_delay_predictions_total[5m]))",
          "legendFormat": "Delay Ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Model Prediction Errors",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
