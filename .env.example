# API and AviationStack
APP_ENV=development
AVIATIONSTACK_API_KEY=replace-with-your-aviationstack-api-key

# Kafka (host and Compose-network addresses)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Cassandra
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042

# MinIO / MLflow development credentials; replace before use
MINIO_ROOT_USER=replace-with-a-local-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-long-local-minio-password
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# Local service ports
API_PORT=8000
KAFKA_EXTERNAL_PORT=9092
SPARK_MASTER_UI_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
CASSANDRA_PORT_PUBLISHED=9042
MLFLOW_PORT=5000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=replace-with-a-local-grafana-user
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-local-grafana-password
